# ============================================
# Dev-only image — hot reload, no production build
# ============================================
# Not meant for deployment. Source is bind-mounted at runtime
# (see compose.dev.yml); the COPY here only warms the layer cache
# so `docker compose up` has a working node_modules on first boot.

FROM oven/bun:1

WORKDIR /app

COPY package.json bun.lock* ./
RUN bun install --frozen-lockfile

COPY . .

ENV NODE_ENV=development
ENV NEXT_TELEMETRY_DISABLED=1

EXPOSE 3000

CMD ["bun", "x", "next", "dev", "--hostname", "0.0.0.0", "--port", "3000"]
